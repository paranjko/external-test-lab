{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonka-dev.net/v1.bootstrap.schema.json",
  "title": "Gonka Network Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "chain_id", "genesis", "seeds"],
  "properties": {
    "$schema": {"const": "https://gonka-dev.net/v1.bootstrap.schema.json"},
    "chain_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "genesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "sha256", "data"],
      "properties": {
        "encoding": {"const": "base64"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data": {"type": "string", "minLength": 4, "maxLength": 1398104, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "host", "port"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "host": {"type": "string", "minLength": 1, "maxLength": 253},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpc": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 2048}},
        "api": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 2048}},
        "inference": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {"type": "string", "maxLength": 2048},
              "authentication": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scheme", "credential"],
                "properties": {
                  "scheme": {"const": "bearer"},
                  "credential": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            }
          }
        }
      }
    }
  }
}
