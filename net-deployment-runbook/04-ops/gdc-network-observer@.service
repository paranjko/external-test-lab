[Unit]
Description=Serve cached public network observation

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/gonka-devnet/network-observer-http.py
StandardInput=socket
StandardOutput=inherit
StandardError=journal
DynamicUser=yes
User=gonka-network-observer
StateDirectory=gonka-network-observer
StateDirectoryMode=0755
RuntimeMaxSec=330
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
