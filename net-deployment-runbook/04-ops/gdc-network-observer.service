[Unit]
Description=Observe Community DevNet topology and software components
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/gonka/gdc-network-observer.env
ExecStart=/usr/local/lib/gonka-devnet/network-observer.sh --refresh
DynamicUser=yes
User=gonka-network-observer
StateDirectory=gonka-network-observer
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
