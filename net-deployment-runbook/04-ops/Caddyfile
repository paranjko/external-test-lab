# The three application origins terminate on the configured public edge in
# edge-node/PublicCaddyfile. The gateway node still needs its own TLS name for
# DAPI peers and chain RPC. Participant status routes are rendered from the
# inventory into /srv/dai/ops/Caddyfile at deployment time.
# `/gateway/*` is the one-participant bootstrap route: it keeps authenticated
# inference available before the secondary-services host has joined.
{$GATEWAY_PUBLIC_HOST} {
  encode zstd gzip

	@prometheus_from_public_edge {
		path /ops-prometheus/*
		remote_ip {$PUBLIC_EDGE_CIDR}
	}
	handle @prometheus_from_public_edge {
		uri strip_prefix /ops-prometheus
		reverse_proxy 127.0.0.1:9099
	}
	handle /ops-prometheus/* {
		respond 403
	}

			handle_path /faucet/* {
				reverse_proxy 127.0.0.1:18081
			}

  handle_path /join-bootstrap/* {
    root * /ops/join-bootstrap
    file_server
  }

  handle_path /gateway/* {
    reverse_proxy 127.0.0.1:18080
  }

  handle {
    reverse_proxy 127.0.0.1:8000
  }
}

http://:8082 {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8080
}

http://:8081 {
  encode zstd gzip

  # Participant cards are derived from committed chain state.  Keeping this
  # read-only REST query on the status origin lets the page discover joins
  # without requiring an `ops site` redeploy after every new operator joins.
  handle /status/participants {
    rewrite * /productscience/inference/inference/participant
    reverse_proxy 127.0.0.1:1317
  }
  handle_path /status/gateway/* {
    reverse_proxy 127.0.0.1:18080
  }
  handle /status/gateway-health {
    root * /status
    rewrite * /gateway-health.json
    header Cache-Control "no-store"
    file_server
  }

  root * /srv
  file_server
  header {
    # The homepage is a live status surface and its JavaScript owns topology
    # reconciliation.  Never let an older app.js keep showing a stale map
    # after a joined node or a site fix is deployed.
    Cache-Control "no-store"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
