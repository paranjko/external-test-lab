# The three application origins terminate on node4/one-net in
# edge-node/PublicCaddyfile.  Node0 still needs its own TLS name: DAPI peers
# use the configured node URL for PoC proof exchange and chain RPC.  Keeping
# this narrowly scoped to NODE0_PUBLIC_HOST preserves that protocol callback.
# `/gateway/*` is the one-participant bootstrap route: it keeps authenticated
# inference available before the secondary-services host has joined.
{$NODE0_PUBLIC_HOST} {
  encode zstd gzip

  handle_path /gateway/* {
    reverse_proxy 127.0.0.1:18080
  }

  handle {
    reverse_proxy 127.0.0.1:8000
  }
}

http://:8082 {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8080
}

http://:8081 {
  encode zstd gzip

  # Participant cards are derived from committed chain state.  Keeping this
  # read-only REST query on the status origin lets the page discover joins
  # without requiring an `ops site` redeploy after every new operator joins.
  handle /status/participants {
    rewrite * /productscience/inference/inference/participant
    reverse_proxy 127.0.0.1:1317
  }
  handle_path /status/node0/* {
    reverse_proxy 127.0.0.1:8000
  }
  handle_path /status/node1/* {
    reverse_proxy https://{$NODE1_PUBLIC_HOST} {
      header_up Host {$NODE1_PUBLIC_HOST}
    }
  }
  handle_path /status/node2/* {
    reverse_proxy https://{$NODE2_PUBLIC_HOST} {
      header_up Host {$NODE2_PUBLIC_HOST}
    }
  }
  handle_path /status/node3/* {
    reverse_proxy https://{$NODE3_PUBLIC_HOST} {
      header_up Host {$NODE3_PUBLIC_HOST}
    }
  }
  handle_path /status/node4/* {
    reverse_proxy https://{$NODE4_PUBLIC_HOST} {
      header_up Host {$NODE4_PUBLIC_HOST}
    }
  }
  handle_path /status/gateway/* {
    reverse_proxy 127.0.0.1:18080
  }

  root * /srv
  file_server
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
