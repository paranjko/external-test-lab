{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "stat",
      "title": "Healthy targets",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "stat",
      "title": "Failed targets",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(up == 0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "stat",
      "title": "Public endpoints up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=\"public-https\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "stat",
      "title": "GPUs available",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(gdc_nvidia_available)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "Consensus height",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "cometbft_consensus_height",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "CPU busy %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "100 - avg by(host)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "Memory used %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)*100",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "GPU utilization %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "gdc_nvidia_utilization_percent",
          "legendFormat": "{{host}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "GPU memory used bytes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "gdc_nvidia_memory_used_bytes",
          "legendFormat": "{{host}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "stat",
      "title": "Operational disk free %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "max by (host) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=~\"/|/srv/dai|/sdb-disk\"}/node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=~\"/|/srv/dai|/sdb-disk\"}*100)",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 15}, {"color": "green", "value": 30}]}}, "overrides": []}
    },
    {
      "id": 11,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "P2P peers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "cometbft_p2p_peers",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "timeseries",
      "title": "Consensus height spread",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "max(cometbft_consensus_height) - min(cometbft_consensus_height)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "table",
      "title": "Network geography",
      "description": "Live host scrape status with static coordinates verified from the current public host addresses.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "up{job=\"host\",city!=\"\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "type": "table",
      "title": "Software inventory",
      "description": "Live exporter and host software labels; this does not infer a Gonka release from container names.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "expr": "node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "cadvisor_version_info",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "node_exporter_build_info",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "go_info{job=\"gonka-node\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ]
    }
  ],
