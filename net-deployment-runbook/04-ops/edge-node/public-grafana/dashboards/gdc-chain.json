      },
      "targets": [
        {
          "expr": "label_replace(max by (gateway) (gdc_chain_gateway_devshards{phase=\"active\"}), \"version\", \"$1\", \"gateway\", \".*_V([0-9]+)\") and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (gateway) (gdc_chain_gateway_hosts{state=\"available\"}) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (gateway) (gdc_chain_gateway_hosts) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (gateway) (gdc_chain_gateway_available_percent) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (gateway) (rate(devshard_gateway_requests_total[5m])) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "E",
          "format": "table",
          "instant": true
        },
        {
          "expr": "100 * sum by (gateway) (rate(devshard_gateway_requests_total{outcome!=\"success\"}[5m])) / (sum by (gateway) (rate(devshard_gateway_requests_total[5m])) > 0) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "F",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (gateway) (devshard_gateway_inflight_requests) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "G",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (gateway) (devshard_gateway_effective_max_concurrent_requests) and on (gateway) (max by (gateway) (gdc_chain_gateway_working) == 1)",
          "refId": "H",
          "format": "table",
          "instant": true
        }
      ],
      "description": "One row per gateway with an active DevShard; gateways without one are hidden. DevShards, hosts and capacity come from the gateway status, traffic, errors and limits from its own metrics over five minutes.",
