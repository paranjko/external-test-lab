{
  email {$ACME_EMAIL}
  admin 127.0.0.1:2019
}
{$PUBLIC_HOST} {
  encode zstd gzip
  @root path /
  redir @root /dashboard/gonka/gov 308
  # The Network Node proxy accepts its public edge as a trusted upstream.
  # Send participant-local public traffic through node4 so callback requests
  # do not arrive at the proxy from its own Docker bridge and get rejected.
  reverse_proxy https://{$NODE4_PUBLIC_HOST} {
    transport http {
      tls_server_name {$NODE4_PUBLIC_HOST}
    }
    header_up Host {$NODE4_PUBLIC_HOST}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
