{
  email {$ACME_EMAIL}
  admin 127.0.0.1:2019
}

# The configured public edge is its Network Node endpoint. The public site and
# API intentionally preserve the gateway host as their application origin while DNS and
# TLS terminate here.
{$PUBLIC_HOST} {
  encode zstd gzip
  # The public edge can proxy normal user traffic to the gateway. Monitoring
  # must not use that route as proof that this Host's own Network Node is up:
  # after a Host reset it would otherwise report the gateway's chain status as
  # this participant's status. This restricted route reaches only the local
  # participant proxy on loopback and returns 502 when that proxy is down.
  @participant_status_from_monitoring {
    path /ops-participant-status/*
    remote_ip {$MONITORING_CIDR}
  }
  handle @participant_status_from_monitoring {
    uri strip_prefix /ops-participant-status
    reverse_proxy 127.0.0.1:8000 {
      header_up Host {$PUBLIC_HOST}
    }
  }
  handle /ops-participant-status/* {
    respond 403
  }
  @telegram_metrics_from_monitoring {
    path /ops-telegram-metrics
    remote_ip {$MONITORING_CIDR}
  }
  handle @telegram_metrics_from_monitoring {
    rewrite * /metrics
    reverse_proxy 127.0.0.1:9464
  }
  handle /ops-telegram-metrics {
    respond 403
  }
  @root path /
  redir @root /dashboard/gonka/gov 308
  # The public edge owns public TLS but is not necessarily a chain participant.
  reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:8000 {
    header_up Host {$GATEWAY_PUBLIC_HOST}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

# Canonical public status origin. DNS may use a direct A record or a CNAME to
# configured public edge, but www must terminate TLS here before redirecting to the apex.
www.{$SITE_HOST} {
  redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
  encode zstd gzip
  # Publish only the consumer readiness summary. The Conversations API and
  # Prometheus endpoint remain loopback-only on the OPS host.
  @telegram_consumer path /status/telegram-consumer
  handle @telegram_consumer {
    rewrite * /health
    reverse_proxy 127.0.0.1:9464
  }
  # The status site is an operations service on the configured public edge, not the Network Node
  # proxy's default dashboard. The public edge remains the only public TLS edge.
  handle {
    reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:8081 {
      header_up Host {$GATEWAY_PUBLIC_HOST}
    }
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

{$API_HOST} {
  encode zstd gzip
  reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:18080 {
    header_up Host {$GATEWAY_PUBLIC_HOST}
  }
}

{$GRAFANA_HOST} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3001
}
