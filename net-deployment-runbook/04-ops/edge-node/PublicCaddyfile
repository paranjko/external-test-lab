{
  email {$ACME_EMAIL}
  admin 127.0.0.1:2019
}

# The configured public edge is its Network Node endpoint. The public site and
# API intentionally preserve the gateway host as their application origin while DNS and
# TLS terminate here.
{$PUBLIC_HOST} {
  encode zstd gzip
  # The public edge can proxy normal user traffic to the gateway. Monitoring
  # must not use that route as proof that this Host's own Network Node is up:
  # after a Host reset it would otherwise report the gateway's chain status as
  # this participant's status. This restricted route reaches only the local
  # participant proxy on loopback and returns 502 when that proxy is down.
  @participant_status_from_monitoring {
    path /ops-participant-status/*
    remote_ip {$MONITORING_CIDR}
  }
  handle @participant_status_from_monitoring {
    uri strip_prefix /ops-participant-status
    reverse_proxy 127.0.0.1:8000 {
      header_up Host {$PUBLIC_HOST}
    }
  }
  handle /ops-participant-status/* {
    respond 403
  }
  # Validators must retrieve this participant's PoC artifacts from the
  # participant recorded on chain.  Sending this path to the gateway would
  # read a different artifact store and can make a healthy Host appear absent.
  @participant_poc path /v1/poc/*
  handle @participant_poc {
    reverse_proxy 127.0.0.1:8000 {
      header_up Host {$PUBLIC_HOST}
    }
  }
  # DevShard protocol traffic is addressed to the participant URL recorded on
  # chain. It must reach this Host's DAPI so responses carry this participant's
  # signing identity instead of the shared gateway Host's identity.
  @participant_devshard path /devshard/*
  handle @participant_devshard {
    reverse_proxy 127.0.0.1:8000 {
      header_up Host {$PUBLIC_HOST}
    }
  }
  # This public edge is also a participant. Its Host-qualified chain routes
  # must prove that participant's own CometBFT identity, not the configured
  # gateway's canonical RPC. Keep this ahead of the public application
  # fallback so /chain-rpc/status and /chain-api/* remain Host-local.
  @participant_chain path /chain-rpc/* /chain-api/*
  handle @participant_chain {
    reverse_proxy 127.0.0.1:8000 {
      header_up Host {$PUBLIC_HOST}
    }
  }
  # Bootstrap documents are static release artifacts. They use no legacy
  # compatibility bundle and expose no credentials or topology.
  route {
    handle /v1.bootstrap.schema.json {
      root * /edge/bootstrap/current
      file_server
    }
    @network_bootstrap path_regexp network_bootstrap ^/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/bootstrap\.(json|env)$
    handle @network_bootstrap {
      root * /edge/bootstrap/current
      file_server
    }
    # Genesis runs the public faucet on the gateway Host.  The initial Community
  # DevNet topology colocates that Host with its public TLS edge, so proxy the
  # explicitly public faucet route to its loopback listener before the
  # explorer fallback below.
    handle_path /faucet/* {
      reverse_proxy 127.0.0.1:18081
    }
    @root path /
    redir @root /dashboard/gonka/gov 308
    # The public edge owns public TLS but is not necessarily a chain participant.
    handle {
      reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:8000 {
        header_up Host {$GATEWAY_PUBLIC_HOST}
      }
    }
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

# Canonical public status origin. DNS may use a direct A record or a CNAME to
# configured public edge, but www must terminate TLS here before redirecting to the apex.
www.{$SITE_HOST} {
  redir https://{$SITE_HOST}{uri} permanent
}

{$SITE_HOST} {
  encode zstd gzip
  # Bootstrap is a public consumer contract on the canonical site origin as
  # well as the node and API origins. Keep this static route ahead of the site
  # fallback so a published descriptor never reaches the dashboard handler.
  handle /v1.bootstrap.schema.json {
    root * /edge/bootstrap/current
    file_server
  }
  @network_bootstrap path_regexp network_bootstrap ^/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/bootstrap\.(json|env)$
  handle @network_bootstrap {
    root * /edge/bootstrap/current
    file_server
  }
  # Publish only the consumer readiness summary. The Conversations API and
  # Prometheus endpoint remain loopback-only on the OPS host.
  @telegram_consumer path /status/telegram-consumer
  handle @telegram_consumer {
    rewrite * /ops-telegram-consumer-health
    reverse_proxy https://{$TELEGRAM_BOT_PUBLIC_HOST} {
      transport http {
        tls_server_name {$TELEGRAM_BOT_PUBLIC_HOST}
      }
      header_up Host {$TELEGRAM_BOT_PUBLIC_HOST}
    }
  }
  # Dynamic status data is fetched from the gateway Host.  The page itself is
  # served locally below, so a reset of that Host leaves a visible, honest
  # OFFLINE state instead of taking the public site down.
  @status_data {
    path /status/*
    not path /status/telegram-consumer
  }
  handle @status_data {
    reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:8081 {
      header_up Host {$GATEWAY_PUBLIC_HOST}
    }
  }
  handle {
    root * /srv/dai/edge/site
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

{$API_HOST} {
  encode zstd gzip
  handle /v1.bootstrap.schema.json {
    root * /edge/bootstrap/current
    file_server
  }
  @network_bootstrap path_regexp network_bootstrap ^/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/bootstrap\.(json|env)$
  handle @network_bootstrap {
    root * /edge/bootstrap/current
    file_server
  }
  # This proxy may wait only before it opens its one gateway connection.
  # Reconciler probes retain their explicit runtime path but share exactly the
  # same permit as public, health, Telegram, and acceptance requests.
  @governed_completion path /v1/chat/completions /devshard/*/v1/chat/completions
  handle @governed_completion {
    reverse_proxy 127.0.0.1:18083
  }
  handle {
    reverse_proxy http://{$GATEWAY_PUBLIC_HOST}:18080 {
      header_up Host {$GATEWAY_PUBLIC_HOST}
    }
  }
}

{$GRAFANA_HOST} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3001
}
