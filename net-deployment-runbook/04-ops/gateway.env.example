DEVSHARD_CHAIN_GRPC=10.77.0.10:9090
DEVSHARD_CHAIN_RPC=http://10.77.0.10:26657
DEVSHARD_CHAIN_ID=gonka-devnet-community
DEVSHARD_PUBLIC_API=http://10.77.0.10:9000
DEVSHARD_PORT=8080
DEVSHARD_STORAGE_DIR=/root/.devshardctl
DEVSHARD_API_KEYS=REPLACE_WITH_ISSUED_CLIENT_KEYS
DEVSHARD_ADMIN_API_KEY=REPLACE_WITH_ADMIN_KEY
DEVSHARD_PRIVATE_KEY=REPLACE_WITH_64_HEX_PRIVATE_KEY
DEVSHARD_ESCROW_ID=REPLACE_AFTER_ESCROW_CREATION
DEVSHARD_MODEL=Qwen/Qwen3-0.6B
DEVSHARD_ROUTE_PREFIX=/devshard/v4
DEVSHARD_POC_REQUEST_MODE=relaxed
DEVSHARD_CAPACITY_AWARE_LIMITS=on
GATEWAY_MAX_CONCURRENT_REQUESTS=8
GATEWAY_MAX_CONCURRENT_REQUESTS_PER_10000_WEIGHT=400
GATEWAY_POC_MAX_CONCURRENT_REQUESTS_PER_10000_WEIGHT=400
GATEWAY_MAX_INPUT_TOKENS_IN_FLIGHT=16384
# Qwen/Qwen3-0.6B has a 2048-token context window; reserve room for prompts.
GATEWAY_DEFAULT_MAX_TOKENS=1024
