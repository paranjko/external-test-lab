        "action": {"enum": ["prepare", "freeze", "stage", "activate", "checkpoint_accept", "retire", "rejoin", "resume_signers", "resume_poc", "resume_handoff", "verify_service", "abort", "expiry_stop", "singleton_extension", "lab_execution"]},
