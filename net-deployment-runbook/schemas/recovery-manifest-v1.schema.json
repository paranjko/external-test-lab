{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonka-dev.net/schemas/recovery-manifest-v1.schema.json",
  "title": "GDC network recovery manifest",
  "description": "Immutable inputs and safety policy for a history-preserving GDC network recovery. This document contains public bindings only; secrets and signer material are forbidden by contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "lifecycle",
    "incident",
    "chain",
    "validator_sets",
    "transition",
    "hosts",
    "first_boundary_policy",
    "runtime",
    "storage",
    "network",
    "trust",
    "retirement",
    "singleton",
    "approvals",
    "verification",
    "coordinator_sha256",
    "execution"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "gdc-network-recovery-manifest"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "incident": {"$ref": "#/$defs/incident"},
    "chain": {"$ref": "#/$defs/chain"},
    "validator_sets": {"$ref": "#/$defs/validator_sets"},
    "transition": {"$ref": "#/$defs/transition"},
    "hosts": {"$ref": "#/$defs/hosts"},
    "first_boundary_policy": {"$ref": "#/$defs/first_boundary_policy"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "storage": {"$ref": "#/$defs/storage"},
    "network": {"$ref": "#/$defs/network"},
    "trust": {"$ref": "#/$defs/trust"},
    "retirement": {"$ref": "#/$defs/retirement"},
    "singleton": {"$ref": "#/$defs/singleton"},
    "approvals": {"$ref": "#/$defs/approvals"},
    "verification": {"$ref": "#/$defs/verification"},
    "coordinator_sha256": {"$ref": "#/$defs/sha256"},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle": {"properties": {"state": {"const": "final"}}, "required": ["state"]}}},
      "then": {
        "properties": {
          "lifecycle": {"required": ["finalized_at", "preparation_draft_sha256"]},
          "transition": {
            "properties": {"new_transition_consensus": {"$ref": "#/$defs/public_key_binding"}}
          },
          "first_boundary_policy": {
            "properties": {
              "case_a": {
                "properties": {
                  "qualified": {"const": true},
                  "qualification_receipt": {"$ref": "#/$defs/artifact_ref"}
                }
              }
            }
          },
          "retirement": {
            "properties": {
              "qualified": {"const": true},
              "qualification_receipt": {"$ref": "#/$defs/artifact_ref"}
            }
          },
          "singleton": {
            "properties": {"expiry_stop_approval_binding": {"$ref": "#/$defs/approval_subject_binding"}}
          },
          "approvals": {
            "properties": {
              "trusted_approvers": {"minItems": 1},
              "phase_policies": {"minItems": 1},
              "qualification_receipts": {"minItems": 1},
              "review_receipts": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "first_boundary_policy": {
            "properties": {"admitted_cases": {"contains": {"const": "B"}}},
            "required": ["admitted_cases"]
          }
        }
      },
      "then": {
        "properties": {
          "first_boundary_policy": {
            "properties": {
              "case_b": {
                "properties": {
                  "admitted": {"const": true},
                  "qualified": {"const": true},
                  "qualification_receipt": {"$ref": "#/$defs/artifact_ref"},
                  "distinct_old_and_new_key_proved": {"const": true}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hex_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 512},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "host_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
    "absolute_path": {"type": "string", "pattern": "^/[A-Za-z0-9._@+/-]+$", "maxLength": 1024},
    "bech32_address": {"type": "string", "pattern": "^gonka(?:valoper|valcons)?1[02-9ac-hj-np-z]{10,100}$"},
    "power": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 80},
    "positive_power": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 80},
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(?:ns|us|ms|s|m|h)$"},
    "endpoint": {
      "type": "string",
      "pattern": "^(?:https?|tcp)://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~%+/-]*)?$",
      "maxLength": 512
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256", "location"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "inspection_receipt",
            "qualification_receipt",
            "review_receipt",
            "approval_receipt",
            "checkpoint_receipt",
            "source_lock",
            "dependency_lock",
            "payload",
            "policy",
            "evidence_manifest"
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "location": {"$ref": "#/$defs/absolute_path"}
      }
    },
    "public_key_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "public_key_sha256", "consensus_address"],
      "properties": {
        "key_id": {"$ref": "#/$defs/identifier"},
        "algorithm": {"enum": ["cometbft/PubKeyEd25519", "ed25519", "secp256k1"]},
        "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 256},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "consensus_address": {"type": "string", "pattern": "^(?:gonka(?:valcons)?1[02-9ac-hj-np-z]{10,100}|[A-Fa-f0-9]{40})$"}
      }
    },
    "participant_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_address", "account_address", "valoper_address", "consensus"],
      "properties": {
        "participant_address": {"$ref": "#/$defs/bech32_address"},
        "account_address": {"$ref": "#/$defs/bech32_address"},
        "valoper_address": {"$ref": "#/$defs/bech32_address"},
        "consensus": {"$ref": "#/$defs/public_key_binding"},
        "warm_address": {"$ref": "#/$defs/bech32_address"},
        "cold_address": {"$ref": "#/$defs/bech32_address"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valoper_address", "consensus", "voting_power", "available_signer"],
      "properties": {
        "valoper_address": {"$ref": "#/$defs/bech32_address"},
        "participant_address": {"$ref": "#/$defs/bech32_address"},
        "consensus": {"$ref": "#/$defs/public_key_binding"},
        "voting_power": {"$ref": "#/$defs/positive_power"},
        "available_signer": {"type": "boolean"}
      }
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_power", "strict_required_power", "available_power", "available_strictly_over_two_thirds"],
      "properties": {
        "total_power": {"$ref": "#/$defs/positive_power"},
        "strict_required_power": {"$ref": "#/$defs/positive_power"},
        "available_power": {"$ref": "#/$defs/power"},
        "available_strictly_over_two_thirds": {"type": "boolean"},
        "calculation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_height", "block_hash", "validators", "quorum", "complete"],
      "properties": {
        "effective_height": {"type": "integer", "minimum": 1},
        "block_hash": {"$ref": "#/$defs/hex_hash"},
        "validators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validator"}},
        "quorum": {"$ref": "#/$defs/quorum"},
        "complete": {"const": true},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_height", "operation", "consensus", "power_before", "power_after"],
      "properties": {
        "effective_height": {"type": "integer", "minimum": 1},
        "operation": {"enum": ["unchanged", "power_change", "add", "remove"]},
        "consensus": {"$ref": "#/$defs/public_key_binding"},
        "power_before": {"$ref": "#/$defs/power"},
        "power_after": {"$ref": "#/$defs/power"}
      }
    },
    "block_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "part_set_header"],
      "properties": {
        "hash": {"$ref": "#/$defs/hex_hash"},
        "part_set_header": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "hash"],
          "properties": {
            "total": {"type": "integer", "minimum": 1},
            "hash": {"$ref": "#/$defs/hex_hash"}
          }
        }
      }
    },
    "commit_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id_flag", "validator_address", "timestamp", "signature"],
      "properties": {
        "block_id_flag": {"enum": [1, 2, 3]},
        "validator_address": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "timestamp": {"type": "string", "format": "date-time"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 256}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "round", "block_id", "signatures", "canonical_json_sha256", "verified"],
      "properties": {
        "height": {"type": "integer", "minimum": 1},
        "round": {"type": "integer", "minimum": 0},
        "block_id": {"$ref": "#/$defs/block_id"},
        "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commit_signature"}},
        "canonical_json_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "draft_id", "created_at", "created_by"],
      "properties": {
        "state": {"enum": ["draft", "final"]},
        "draft_id": {"$ref": "#/$defs/identifier"},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"$ref": "#/$defs/identifier"},
        "finalized_at": {"type": "string", "format": "date-time"},
        "preparation_draft_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "draft"}}}, "then": {"not": {"anyOf": [{"required": ["finalized_at"]}, {"required": ["preparation_draft_sha256"]}]}}}
      ]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "plan_id", "plan_revision", "implementation_base", "implementation_branch"],
      "properties": {
        "incident_id": {"const": "GNK-LAB-2026-0001"},
        "plan_id": {"const": "GNK-LAB-2026-0001-HF"},
        "plan_revision": {"$ref": "#/$defs/sha256"},
        "implementation_base": {"$ref": "#/$defs/git_commit"},
        "implementation_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "genesis", "source_height", "block_id_h", "commit_h", "source_application_hash", "highest_valid_commit_height"],
      "properties": {
        "chain_id": {"const": "gonka-devnet-community"},
        "genesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_sha256", "semantic_sha256"],
          "properties": {
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "semantic_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "source_height": {"type": "integer", "minimum": 1},
        "block_id_h": {"$ref": "#/$defs/block_id"},
        "commit_h": {"$ref": "#/$defs/commit"},
        "source_application_hash": {"$ref": "#/$defs/hex_hash"},
        "highest_valid_commit_height": {"type": "integer", "minimum": 1},
        "archive_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_height", "last_height", "verified"],
          "properties": {
            "first_height": {"const": 1},
            "last_height": {"type": "integer", "minimum": 1},
            "verified": {"const": true},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "signer_control_entry": {
      "description": "HF-01: classifies one H+1 validator as controlled (host) or lost (evidence_ref).",
      "type": "object",
      "additionalProperties": false,
      "required": ["valoper_address", "classification"],
      "properties": {
        "valoper_address": {"$ref": "#/$defs/bech32_address"},
        "classification": {"enum": ["controlled", "lost"]},
        "host": {"$ref": "#/$defs/host_name"},
        "evidence_ref": {"$ref": "#/$defs/artifact_ref"}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"const": "controlled"}}}, "then": {"required": ["host"]}},
        {"if": {"properties": {"classification": {"const": "lost"}}}, "then": {"required": ["evidence_ref"]}}
      ]
    },
    "validator_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old", "current", "next", "singleton_v_star", "signer_control_matrix"],
      "properties": {
        "old": {"$ref": "#/$defs/validator_set"},
        "current": {"$ref": "#/$defs/validator_set"},
        "next": {"$ref": "#/$defs/validator_set"},
        "signer_control_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/signer_control_entry"}
        },
        "singleton_v_star": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_first_height", "validator", "expected_total_power", "expected_strict_required_power"],
          "properties": {
            "expected_first_height": {"type": "integer", "minimum": 2},
            "validator": {"$ref": "#/$defs/validator"},
            "expected_total_power": {"$ref": "#/$defs/positive_power"},
            "expected_strict_required_power": {"$ref": "#/$defs/positive_power"}
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "participant_address", "account_address", "valoper_address", "old_participant_consensus", "new_transition_consensus", "old_and_new_keys_must_differ", "entrypoint", "initialization_command"],
      "properties": {
        "host": {"$ref": "#/$defs/host_name"},
        "participant_address": {"$ref": "#/$defs/bech32_address"},
        "account_address": {"$ref": "#/$defs/bech32_address"},
        "valoper_address": {"$ref": "#/$defs/bech32_address"},
        "old_participant_consensus": {"$ref": "#/$defs/public_key_binding"},
        "new_transition_consensus": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/public_key_binding"}]},
        "old_and_new_keys_must_differ": {"const": true},
        "entrypoint": {"$ref": "#/$defs/absolute_path"},
        "initialization_command": {"const": "in-place-testnet"}
      }
    },
    "signer_predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_state_present", "binding_verified", "duplicate_absent", "conflicting_lab_history_absent"],
      "properties": {
        "native_state_present": {"type": "boolean"},
        "binding_verified": {"type": "boolean"},
        "duplicate_absent": {"type": "boolean"},
        "conflicting_lab_history_absent": {"type": "boolean"},
        "native_state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "roles", "return_position", "source_signer_mode", "recovery_signer_mode", "participant", "signer_handoff_predicates", "approved_services"],
      "properties": {
        "host": {"$ref": "#/$defs/host_name"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["transition", "returning", "archive", "observer", "monitor"]}
        },
        "return_position": {"type": ["integer", "null"], "minimum": 1},
        "source_signer_mode": {"enum": ["local_file_pv", "tmkms", "none"]},
        "recovery_signer_mode": {"enum": ["transition_local_file_pv", "temporary_nonvalidator_file_pv", "none"]},
        "participant": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/participant_binding"}]},
        "signer_handoff_predicates": {"$ref": "#/$defs/signer_predicates"},
        "approved_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["core", "tmkms", "api", "ml", "proxy", "snapshot"]}
        },
        "split_ml_host": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/host_name"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"roles": {"contains": {"const": "returning"}}}},
          "then": {"properties": {"return_position": {"type": "integer", "minimum": 1}}}
        },
        {
          "if": {"properties": {"roles": {"not": {"contains": {"const": "returning"}}}}},
          "then": {"properties": {"return_position": {"type": "null"}}}
        },
        {
          "if": {"properties": {"roles": {"contains": {"const": "transition"}}}}, "then": {
            "properties": {"roles": {"not": {"contains": {"const": "returning"}}}}
          }
        }
      ]
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings", "freeze_hosts", "return_order", "monitoring_operator"],
      "properties": {
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/host_binding"}},
        "freeze_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/host_name"}},
        "return_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/host_name"}},
        "monitoring_operator": {"$ref": "#/$defs/identifier"}
      },
      "allOf": [
        {
          "properties": {
            "bindings": {
              "contains": {
                "type": "object",
                "properties": {"roles": {"type": "array", "contains": {"const": "transition"}}},
                "required": ["roles"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    },
    "runtime_flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "raw_value", "parsed_value", "parser_source_revision"],
      "properties": {
        "presence": {"enum": ["unset", "explicit"]},
        "raw_value": {"type": ["string", "null"], "maxLength": 64},
        "parsed_value": {"type": "boolean"},
        "parser_source_revision": {"$ref": "#/$defs/git_commit"}
      },
      "allOf": [
        {"if": {"properties": {"presence": {"const": "unset"}}}, "then": {"properties": {"raw_value": {"type": "null"}}}},
        {"if": {"properties": {"presence": {"const": "explicit"}}}, "then": {"properties": {"raw_value": {"type": "string", "minLength": 1}}}}
      ]
    },
    "epoch_seed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_height", "epoch_index", "epoch_start_height", "epoch_end_height", "seed_present", "group"],
      "properties": {
        "observed_height": {"type": "integer", "minimum": 1},
        "epoch_index": {"type": "integer", "minimum": 0},
        "epoch_start_height": {"type": "integer", "minimum": 1},
        "epoch_end_height": {"type": "integer", "minimum": 1},
        "seed_present": {"type": "boolean"},
        "seed_sha256": {"$ref": "#/$defs/sha256"},
        "group": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bech32_address"}},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundary_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "observed_height", "effective_height", "group", "validator_set", "updates", "supporting_commit_sha256"],
      "properties": {
        "label": {"enum": ["before", "after", "effective"]},
        "observed_height": {"type": "integer", "minimum": 1},
        "effective_height": {"type": "integer", "minimum": 1},
        "group": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bech32_address"}},
        "validator_set": {"$ref": "#/$defs/validator_set"},
        "updates": {"type": "array", "items": {"$ref": "#/$defs/validator_update"}},
        "supporting_commit_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator_power_change_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_height", "operation", "consensus", "power_before", "power_after"],
      "properties": {
        "effective_height": {"type": "integer", "minimum": 1},
        "operation": {"const": "power_change"},
        "consensus": {"$ref": "#/$defs/public_key_binding"},
        "power_before": {"$ref": "#/$defs/power"},
        "power_after": {"$ref": "#/$defs/positive_power"}
      }
    },
    "boundary_case_a": {
      "description": "5.7 case A: empty group, no validator update.",
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "qualified", "qualification_receipt", "expected_group", "allowed_updates", "qualification_records"],
      "properties": {
        "admitted": {"type": "boolean"},
        "qualified": {"type": "boolean"},
        "qualification_receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
        "expected_group": {"type": "array", "maxItems": 0, "uniqueItems": true, "items": {"$ref": "#/$defs/bech32_address"}},
        "allowed_updates": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/validator_update"}},
        "qualification_records": {"type": "array", "items": {"$ref": "#/$defs/boundary_record"}},
        "distinct_old_and_new_key_proved": {"type": "boolean"}
      }
    },
    "boundary_case_b": {
      "description": "5.7 case B: only the transition identity, one power change, no add or remove.",
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "qualified", "qualification_receipt", "expected_group", "allowed_updates", "qualification_records"],
      "properties": {
        "admitted": {"type": "boolean"},
        "qualified": {"type": "boolean"},
        "qualification_receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
        "expected_group": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/bech32_address"}},
        "allowed_updates": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/validator_power_change_update"}},
