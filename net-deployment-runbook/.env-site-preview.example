# Copy to $GDC_HOME/.env-site-preview (default $HOME/.gdc-data), or to this
# directory for a checkout-local override, and set mode 0600.
DEPLOY_HOST=node4.gonka-dev.net
DEPLOY_USER=preview

# Local deploy authentication. Both files must be readable only by the owner.
# The private key stays outside this repository and is never copied into Git.
DEPLOY_PRIVATE_KEY_FILE=/home/your-user/.ssh/gonka-preview-deploy
DEPLOY_KNOWN_HOSTS_FILE=/home/your-user/.ssh/gonka-preview-known_hosts

# The rootless preview egress proxy may query only this local Prometheus
# endpoint. It is not passed to preview application code.
PREVIEW_PROMETHEUS_ORIGIN=http://node4.gonka-dev.net:9099
