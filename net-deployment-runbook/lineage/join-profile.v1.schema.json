{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gonka-dev.net/schemas/join-profile.v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","kind","run_id","created_at","valid_until","operation","observation","profile_id","spec","decision"],
  "properties":{
    "schema_version":{"const":1},"kind":{"const":"gdc-host-join-profile"},
    "run_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "created_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},
    "operation":{"enum":["new","restore"]},"observation":{"$ref":"#/$defs/observation"},
    "profile_id":{"$ref":"#/$defs/sha256"},"spec":{"$ref":"#/$defs/spec"},
    "decision":{"enum":["ready_full","refused"]}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "url":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~/%:-]*)?$"},
    "observation":{"type":"object","additionalProperties":false,"required":["sha256","network_state_id"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"network_state_id":{"$ref":"#/$defs/sha256"}}},
    "component":{"type":"object","additionalProperties":false,"required":["observed","installation","expected_runtime","mapping_source"],"properties":{
      "observed":{"$ref":"#/$defs/version_commit"},"expected_runtime":{"$ref":"#/$defs/version_commit"},
      "installation":{"type":"object","additionalProperties":false,"required":["mode","image"],"properties":{"mode":{"enum":["native_image","image_plus_cosmovisor","qualified_image","local_oci_bundle"]},"image":{"type":"object","additionalProperties":false,"required":["repository","digest"],"properties":{"repository":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}},"binary":{"type":"object","additionalProperties":false,"required":["url","sha256"],"properties":{"url":{"$ref":"#/$defs/url"},"sha256":{"$ref":"#/$defs/sha256"}}}}},
      "mapping_source":{"type":"object","additionalProperties":false,"required":["kind","id","definition_sha256"],"properties":{"kind":{"enum":["qualified_catalog","release_lock_component","official_artifact","official_oci_runtime","dynamic_build"]},"id":{"type":"string","minLength":1},"definition_sha256":{"$ref":"#/$defs/sha256"}}}
    }},
    "version_commit":{"type":"object","additionalProperties":false,"required":["version","commit"],"properties":{"version":{"type":"string","minLength":1,"maxLength":64},"commit":{"$ref":"#/$defs/commit"}}},
    "approved":{"type":"object","additionalProperties":false,"required":["name","url","sha256"],"properties":{"name":{"type":"string","pattern":"^v[1-9][0-9]*$"},"url":{"$ref":"#/$defs/url"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["network","seeds","target","deployment","components","state_acquisition","identity","activation_policy"],"properties":{
      "network":{"type":"object","additionalProperties":false,"required":["chain_id","genesis_sha256","bootstrap_sha256","bootstrap_url"],"properties":{"chain_id":{"type":"string","minLength":1},"genesis_sha256":{"$ref":"#/$defs/sha256"},"bootstrap_sha256":{"$ref":"#/$defs/sha256"},"bootstrap_url":{"$ref":"#/$defs/url"}}},
      "seeds":{"type":"object","additionalProperties":false,"required":["usable","unavailable"],"properties":{"usable":{"type":"array","minItems":1,"items":{"type":"object"}},"unavailable":{"type":"array","items":{"type":"object"}}}},
      "target":{"type":"object","additionalProperties":false,"required":["node_name","public_host","public_p2p_address","platform"],"properties":{"node_name":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},"public_host":{"type":"string","pattern":"^[A-Za-z0-9.-]+$"},"public_p2p_address":{"type":"string","pattern":"^tcp://[A-Za-z0-9.-]+:[1-9][0-9]{0,4}$"},"platform":{"const":"linux-amd64"}}},
      "deployment":{"type":"object","additionalProperties":false,"required":["gdc_source_commit","data_layout","host_envelope"],"properties":{"gdc_source_commit":{"$ref":"#/$defs/commit"},"data_layout":{"const":"gdc-data-layout/v2"},"host_envelope":{"$ref":"#/$defs/host_envelope"}}},
      "components":{"type":"object","additionalProperties":false,"required":["core","dapi"],"properties":{"core":{"$ref":"#/$defs/component"},"dapi":{"$ref":"#/$defs/component"}}},
      "state_acquisition":{"type":"object","additionalProperties":false,"required":["mode","providers","minimum_providers"],"properties":{"mode":{"enum":["pending","native_p2p_state_sync"]},"providers":{"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{40}@tcp://[A-Za-z0-9.-]+:[1-9][0-9]{0,4}$"}},"minimum_providers":{"type":"integer","minimum":0}}},
      "identity":{"type":"object","additionalProperties":false,"required":["mode","stable_identity_layout"],"properties":{"mode":{"enum":["generate","restore"]},"stable_identity_layout":{"const":"gdc-identity-layout/v2"},"restore_archive_sha256":{"$ref":"#/$defs/sha256"}}},
      "activation_policy":{"type":"object","additionalProperties":false,"required":["application_required_for_complete","signer_allowed_in_profile","old_signer_fence_required"],"properties":{"application_required_for_complete":{"const":true},"signer_allowed_in_profile":{"const":false},"old_signer_fence_required":{"type":"boolean"}}}
    }},
    "host_envelope":{"type":"object","additionalProperties":false,"required":["tmkms_image","postgres_image","edge_api_image","versiond_image","proxy_image","explorer_image","mlnode_image","mlnode_proxy_image","caddy_image","grafana_image","node_exporter_image","cadvisor_image","host_stack","dashboard_port","edge_api_compose_profile","edge_api_service_name","model_id","model_revision","mlnode_context_length","mlnode_max_num_seqs","mlnode_gpu_memory_utilization","mlnode_dtype","mlnode_tensor_parallel_size","join_effective_epochs","join_effective_timeout_seconds","mapping_source"],"properties":{"tmkms_image":{"$ref":"#/$defs/digest_image"},"postgres_image":{"$ref":"#/$defs/digest_image"},"edge_api_image":{"$ref":"#/$defs/digest_image"},"versiond_image":{"$ref":"#/$defs/digest_image"},"proxy_image":{"$ref":"#/$defs/digest_image"},"explorer_image":{"$ref":"#/$defs/digest_image"},"mlnode_image":{"$ref":"#/$defs/digest_image"},"mlnode_proxy_image":{"$ref":"#/$defs/digest_image"},"caddy_image":{"$ref":"#/$defs/digest_image"},"grafana_image":{"$ref":"#/$defs/digest_image"},"node_exporter_image":{"$ref":"#/$defs/digest_image"},"cadvisor_image":{"$ref":"#/$defs/digest_image"},"host_stack":{"type":"object","additionalProperties":false,"required":["repository","commit","compose_sha256","api_image"],"properties":{"repository":{"const":"gonka-ai/gonka"},"commit":{"$ref":"#/$defs/commit"},"compose_sha256":{"$ref":"#/$defs/sha256"},"api_image":{"$ref":"#/$defs/digest_image"}}},"dashboard_port":{"type":"integer","minimum":1,"maximum":65535},"edge_api_compose_profile":{"type":"string","minLength":1},"edge_api_service_name":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"model_revision":{"$ref":"#/$defs/commit"},"mlnode_context_length":{"type":"integer","minimum":1},"mlnode_max_num_seqs":{"type":"integer","minimum":1},"mlnode_gpu_memory_utilization":{"type":"string","pattern":"^0\\.[0-9]+$|^1(\\.0+)?$"},"mlnode_dtype":{"type":"string","minLength":1},"mlnode_tensor_parallel_size":{"type":"integer","minimum":1},"join_effective_epochs":{"type":"integer","minimum":1},"join_effective_timeout_seconds":{"type":"integer","minimum":1},"mapping_source":{"$ref":"#/$defs/mapping_source"}}},
    "digest_image":{"type":"string","pattern":"^[A-Za-z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "mapping_source":{"type":"object","additionalProperties":false,"required":["kind","id","definition_sha256"],"properties":{"kind":{"enum":["qualified_catalog","release_lock_component","official_artifact","dynamic_build"]},"id":{"type":"string","minLength":1},"definition_sha256":{"$ref":"#/$defs/sha256"}}}
    }
  }
