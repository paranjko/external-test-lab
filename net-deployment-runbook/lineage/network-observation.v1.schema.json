{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonka-dev.net/schemas/network-observation.v1.schema.json",
  "title": "GDC Host JOIN runtime observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "observed_at", "expires_at", "network_state_id", "bootstrap", "policy", "seeds", "runtime_api_origins", "runtime", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "gdc-network-observation"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "network_state_id": {"$ref": "#/$defs/sha256"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "policy": {"$ref": "#/$defs/policy"},
    "seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed"}},
    "runtime_api_origins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime_source"}},
    "runtime": {"$ref": "#/$defs/runtime"},
    "result": {"type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {"state": {"const": "ready"}, "reason": {"const": "none"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "https_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~/%:-]*)?$"},
    "component": {"type": "object", "additionalProperties": false, "required": ["version", "commit"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 64}, "commit": {"$ref": "#/$defs/commit"}}},
    "observed_component": {"type": "object", "additionalProperties": false, "required": ["application_name", "version", "commit"], "properties": {"application_name": {"enum": ["inference-chain", "decentralized-api"]}, "version": {"type": "string", "minLength": 1, "maxLength": 64}, "commit": {"$ref": "#/$defs/commit"}}},
    "bootstrap": {"type": "object", "additionalProperties": false, "required": ["url", "document_sha256", "chain_id", "genesis_sha256"], "properties": {"url": {"$ref": "#/$defs/https_url"}, "document_sha256": {"$ref": "#/$defs/sha256"}, "chain_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}, "genesis_sha256": {"$ref": "#/$defs/sha256"}}},
    "seed": {"type": "object", "additionalProperties": false, "required": ["seed_index", "expected_node_id", "rpc_url", "api_url", "status", "reason", "catching_up", "abci_version", "cometbft_version"], "properties": {"seed_index": {"type": "integer", "minimum": 0}, "expected_node_id": {"$ref": "#/$defs/commit"}, "rpc_url": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?/chain-rpc$"}, "api_url": {"type": "string", "pattern": "^$|^https?://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~/%:-]*)?$"}, "status": {"enum": ["usable", "unavailable", "invalid"]}, "reason": {"type": "string", "minLength": 1}, "catching_up": {"type": "boolean"}, "abci_version": {"type": "string", "maxLength": 64}, "cometbft_version": {"type": "string", "maxLength": 64}}},
    "runtime_source": {"type": "object", "additionalProperties": false, "required": ["seed_index", "expected_node_id", "api_url", "api_source", "observed_at", "core", "dapi", "cometbft", "versions_response_sha256"], "properties": {"seed_index": {"type": "integer", "minimum": -1}, "expected_node_id": {"$ref": "#/$defs/commit"}, "api_url": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~/%:-]*)?$"}, "api_source": {"enum": ["declared", "derived"]}, "observed_at": {"type": "string", "format": "date-time"}, "core": {"$ref": "#/$defs/component"}, "dapi": {"$ref": "#/$defs/component"}, "cometbft": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 64}}}, "versions_response_sha256": {"$ref": "#/$defs/sha256"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["core", "dapi", "cometbft"], "properties": {"core": {"$ref": "#/$defs/component"}, "dapi": {"$ref": "#/$defs/component"}, "cometbft": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 64}}}}},
    "tuple_group": {"type": "object", "additionalProperties": false, "required": ["tuple", "count", "node_ids", "remote_ips", "discovery_root_ids", "discovery_root_count"], "properties": {"tuple": {"type": "object", "additionalProperties": false, "required": ["core", "dapi"], "properties": {"core": {"allOf": [{"$ref": "#/$defs/observed_component"}, {"properties": {"application_name": {"const": "inference-chain"}}}]}, "dapi": {"allOf": [{"$ref": "#/$defs/observed_component"}, {"properties": {"application_name": {"const": "decentralized-api"}}}]}}}, "count": {"type": "integer", "minimum": 1}, "node_ids": {"type": "array", "items": {"$ref": "#/$defs/commit"}}, "remote_ips": {"type": "array", "items": {"type": "string", "minLength": 1}}, "discovery_root_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commit"}}, "discovery_root_count": {"type": "integer", "minimum": 1}}},
    "component_group": {"type": "object", "additionalProperties": false, "required": ["tuple", "count", "node_ids", "remote_ips", "discovery_root_ids", "discovery_root_count"], "properties": {"tuple": {"$ref": "#/$defs/observed_component"}, "count": {"type": "integer", "minimum": 1}, "node_ids": {"type": "array", "items": {"$ref": "#/$defs/commit"}}, "remote_ips": {"type": "array", "items": {"type": "string", "minLength": 1}}, "discovery_root_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commit"}}, "discovery_root_count": {"type": "integer", "minimum": 1}}},
    "excluded_record": {"type": "object", "additionalProperties": false, "required": ["node_id", "remote_ip", "status", "reason"], "properties": {"node_id": {"$ref": "#/$defs/commit"}, "remote_ip": {"type": "string", "minLength": 1}, "status": {"enum": ["unavailable", "excluded", "invalid"]}, "reason": {"type": "string", "minLength": 1}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["state", "selection_stage", "valid_observation_count", "minimum_quorum", "minimum_independent_discovery_roots", "strict_majority_count", "dapi_group_count", "dapi_majority_count", "dapi_groups", "core_group_count", "core_majority_count", "core_groups", "pair_support_count", "selected_discovery_root_ids", "selected_discovery_root_count", "conflicting_node_ids", "conflicting_remote_ips", "groups", "dapi_selected", "core_selected", "selected", "excluded_observations"], "properties": {"state": {"enum": ["ready", "insufficient_quorum", "insufficient_discovery_roots", "identity_conflict", "no_strict_majority", "software_ambiguous"]}, "selection_stage": {"enum": ["none", "core", "pair"]}, "valid_observation_count": {"type": "integer", "minimum": 0}, "minimum_quorum": {"type": "integer", "minimum": 2}, "minimum_independent_discovery_roots": {"type": "integer", "minimum": 2}, "strict_majority_count": {"type": "integer", "minimum": 0}, "dapi_group_count": {"type": "integer", "minimum": 0}, "dapi_majority_count": {"type": "integer", "minimum": 0}, "dapi_groups": {"type": "array", "items": {"$ref": "#/$defs/component_group"}}, "core_group_count": {"type": "integer", "minimum": 0}, "core_majority_count": {"type": "integer", "minimum": 0}, "core_groups": {"type": "array", "items": {"$ref": "#/$defs/component_group"}}, "pair_support_count": {"type": "integer", "minimum": 0}, "selected_discovery_root_ids": {"type": "array", "items": {"$ref": "#/$defs/commit"}}, "selected_discovery_root_count": {"type": "integer", "minimum": 0}, "conflicting_node_ids": {"type": "array", "items": {"$ref": "#/$defs/commit"}}, "conflicting_remote_ips": {"type": "array", "items": {"type": "string", "minLength": 1}}, "groups": {"type": "array", "items": {"$ref": "#/$defs/tuple_group"}}, "dapi_selected": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/component_group"}]}, "core_selected": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/component_group"}]}, "selected": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/tuple_group"}]}, "excluded_observations": {"type": "array", "items": {"$ref": "#/$defs/excluded_record"}}}},
    "peer_record": {"type": "object", "additionalProperties": false, "required": ["discovery_root_ids", "node_id", "remote_ip"], "properties": {"discovery_root_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commit"}}, "node_id": {"$ref": "#/$defs/commit"}, "remote_ip": {"type": "string", "minLength": 1}}},
    "quorum_policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "source", "scope", "minimum_valid_observations", "minimum_independent_discovery_roots", "definition_sha256"], "properties": {"policy_id": {"const": "gdc-join-software-quorum/v1"}, "source": {"const": "runbook_local"}, "scope": {"enum": ["network", "default"]}, "minimum_valid_observations": {"type": "integer", "minimum": 2}, "minimum_independent_discovery_roots": {"type": "integer", "minimum": 2}, "definition_sha256": {"$ref": "#/$defs/sha256"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_sha256", "mode", "minimum_valid_observations", "maximum_age_seconds", "quorum_policy", "authority", "discovered_peers", "excluded_observations"], "properties": {"policy_id": {"const": "net-info-software-majority/v1"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "mode": {"const": "strict_majority"}, "minimum_valid_observations": {"type": "integer", "minimum": 2}, "maximum_age_seconds": {"type": "integer", "minimum": 1}, "quorum_policy": {"$ref": "#/$defs/quorum_policy"}, "authority": {"$ref": "#/$defs/authority"}, "discovered_peers": {"type": "array", "items": {"$ref": "#/$defs/peer_record"}}, "excluded_observations": {"type": "array", "items": {"$ref": "#/$defs/excluded_record"}}}}
  }
}
