# Values that must be chosen for this deployment.
ACME_EMAIL=operator@example.com
# Optional logical participants deliberately excluded from this rehearsal.
# Example: GDC_SKIP_HOSTS=gdc-node3
GDC_SKIP_HOSTS=
# Optional per-node backing directory for the canonical /srv/dai data root.
# The directory must live on a separately mounted filesystem and be empty on
# first use; preparation migrates existing /srv/dai data, then installs a
# persistent bind mount. Example: GDC_NODE2_DATA_ROOT=/mnt/fastdisk/gonka-dai
GDC_NODE2_DATA_ROOT=
# Public BotFather username, after creating the bot. Example:
# GDC_TELEGRAM_BOT_URL=https://t.me/gonka_devnet_bot
GDC_TELEGRAM_BOT_URL=
