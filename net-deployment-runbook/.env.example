# Values that must be chosen for this deployment.
ACME_EMAIL=operator@example.com
# Network deployment policy and operator support software are selected
# independently from --release and --model.
GDC_DEPLOYMENT_PROFILE=community-lab
GDC_OPERATOR_SERVICES_PROFILE=gdc-lab
# Optional logical participants deliberately excluded from this rehearsal.
# Example: GDC_SKIP_HOSTS=gdc-node3
GDC_SKIP_HOSTS=
# Public BotFather username, after creating the bot. Example:
# GDC_TELEGRAM_BOT_URL=https://t.me/gonka_devnet_bot
GDC_TELEGRAM_BOT_URL=
# BotFather token. This is the only operator environment file; never create a
# second .env under scripts/telegram-bot.
TELEGRAM_BOT_TOKEN=replace-with-BotFather-token
# The normal distributed route. bootstrap-access overrides this with node0's
# temporary one-participant route automatically.
GDC_TELEGRAM_BOT_API_BASE_URL=https://api.gonka-dev.net/v1
# Zero is the gateway's documented unlimited value. This test lab does not
# impose an artificial per-key or gateway-wide request budget; the live model,
# DevShard and chain state remain the real availability boundary.
GDC_GATEWAY_MAX_CONCURRENT_REQUESTS=0
# The gateway normalizes 0 here to its conservative default, so use an
# intentionally non-limiting test-lab value instead.
GDC_GATEWAY_MAX_CONCURRENT_PER_10000_WEIGHT=1000000000
GDC_GATEWAY_MAX_INPUT_TOKENS_IN_FLIGHT=0
# The gateway's participant limiter is distinct from the public request limits
# above.  Use intentionally non-limiting values in this controlled test lab;
# otherwise a completed load rehearsal can make every valid Telegram key return
# HTTP 429 while the technical health probe still reports READY.
GDC_GATEWAY_PARTICIPANT_REQUEST_BURST=1000000000
GDC_GATEWAY_PARTICIPANT_RECOVERY_PER_MINUTE=1000000000
GDC_GATEWAY_PRE_POC_BLOCKS=5
GDC_GATEWAY_ROTATION_TEMP_COUNT=2
GDC_GATEWAY_ROTATION_TARGET_COUNT=2
# Guardians are excluded from PoC preserved runtimes. Disable the Genesis
# guardian in the Community assurance profile so joined model capacity can
# serve chain-accounted inference through PoC. This is Genesis-only.
GDC_GENESIS_GUARDIAN_ENABLED=false
# 0.2.14 retries weight distribution after 30 seconds. Keep the chain exchange
# window open for that retry so the final artifact commitment is observable.
GDC_POC_EXCHANGE_DURATION=8
# Keep authenticated access available across short DevNet escrow-retention
# windows. The gateway creates a replacement escrow before the epoch switch;
# issued API keys remain unchanged because they authenticate the gateway, not
# one particular escrow.
GDC_GATEWAY_ESCROW_ROTATION_ENABLED=true
GDC_GATEWAY_ESCROW_ROTATION_SETTLEMENT_ENABLED=true
# Keep the Genesis-funded 100 GNK test balance available for automatic escrow
# rotation. This is a reserve target, not a request quota; settled escrows
# recycle their remaining balance.
GDC_GATEWAY_MIN_SPENDABLE_NGONKA=100000000000
# Empty means the live governance minimum. Set a larger ngonka amount only
# when the gateway account has enough spendable balance after proposal deposits.
GDC_GATEWAY_ESCROW_AMOUNT_NGONKA=
# Sepolia deployment inputs. Prefer a separate mode-0600 key file; the command
# never accepts a private key as a CLI argument.
GDC_SEPOLIA_PRIVATE_KEY_FILE=
GDC_SEPOLIA_PRIVATE_KEY=
GDC_SEPOLIA_RPC_URL=
# Set after bridge-deploy and Community DevNet governance registration.
GDC_SEPOLIA_CONTRACT=
# Independent Prysm checkpoint-sync URL, not the execution RPC above.
GDC_SEPOLIA_BEACON_STATE_URL=
