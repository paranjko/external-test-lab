    "native_counts":{"type":"object","additionalProperties":false,"required":["passed","failed","broken","skipped","unknown"],"properties":{"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"broken":{"type":"integer","minimum":0},"skipped":{"type":"integer","minimum":0},"unknown":{"type":"integer","minimum":0}}}
  }
}
