{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://gonka.dev/gonkactl-test/schemas/v1/coverage.schema.json",
  "title":"gonkactl-test coverage v1", "type":"object", "additionalProperties":false, "required":["schema_version","campaign_id","scope_hash","obligations","native_counts"],
  "properties":{"schema_version":{"type":"string","pattern":"^1\\.[0-9]+\\.[0-9]+$"},"campaign_id":{"type":"string","minLength":1},"scope_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "obligations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["obligation_id","rule_id","contract_revision","required_variant","evidence_requirement","automated","applicability","attempted","asserted","confirmed","gap_reasons","blocked_by"],"properties":{
      "obligation_id":{"type":"string","minLength":1},"rule_id":{"type":"string","minLength":1},"contract_revision":{"type":"string","minLength":1},"required_variant":{"type":"string","minLength":1},"evidence_requirement":{"type":"string","minLength":1},"automated":{"type":"boolean"},"applicability":{"enum":["applicable","not_applicable","unresolved"]},"attempted":{"type":"boolean"},"asserted":{"type":"boolean"},"confirmed":{"type":"boolean"},"gap_reasons":{"type":"array","items":{"enum":["no-scenario","not-automated","not-selected","not-run","unresolved","blocked","skipped","failed","stale","unknown-evidence"]}},"blocked_by":{"type":"array","items":{"type":"string","minLength":1}}
