{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://gonka.dev/gonkactl-test/schemas/v1/evidence-manifest.schema.json",
  "title":"gonkactl-test evidence manifest v1", "type":"object", "additionalProperties":false, "required":["schema_version","run_id","entries"],
  "properties":{"schema_version":{"type":"string","pattern":"^1\\.[0-9]+\\.[0-9]+$"},"run_id":{"type":"string","minLength":1},"entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","sha256","bytes","mime","sensitivity","source_event_id","availability","reason"],"properties":{
    "path":{"type":"string","minLength":1,"not":{"anyOf":[{"pattern":"^/"},{"pattern":"(^|/)\\.\\.(/|$)"},{"pattern":"(^|/)tmp(/|$)"}]}},"sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"bytes":{"type":["integer","null"],"minimum":0},"mime":{"type":"string","minLength":1},"sensitivity":{"enum":["public","internal","secret"]},"source_event_id":{"type":"string","minLength":1},"availability":{"enum":["available","omitted","truncated","unavailable"]},"reason":{"type":["string","null"]}
  }}}}
}
