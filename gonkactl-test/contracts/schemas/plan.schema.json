{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonka.dev/gonkactl-test/schemas/v1/plan.schema.json",
  "title": "gonkactl-test plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "scope_hash", "resolved_sources", "catalog_revision", "bindings_revision", "cases", "environment_intent", "composition_digest", "prerequisites", "deadlines", "concurrency", "retry_policy"],
  "properties": {
    "schema_version": {"type":"string", "pattern":"^1\\.[0-9]+\\.[0-9]+$"},
    "campaign_id": {"type":"string", "minLength":1},
    "scope_hash": {"$ref":"#/$defs/sha256"},
    "resolved_sources": {"type":"array", "minItems":1, "items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/relativePath"},"sha256":{"$ref":"#/$defs/sha256"}}}},
    "catalog_revision": {"type":"string", "minLength":1},
    "bindings_revision": {"type":"string", "minLength":1},
    "cases": {"type":"array", "minItems":1, "items":{"type":"object","additionalProperties":false,"required":["case_id","applicability"],"properties":{"case_id":{"type":"string","minLength":1},"applicability":{"enum":["applicable","not_applicable","unresolved"]},"reason":{"type":"string","minLength":1}}}},
    "environment_intent": {"type":"object", "additionalProperties":true, "required":["environment_id"], "properties":{"environment_id":{"type":"string","minLength":1},"environment_instance_id":{"type":["string","null"]}}},
    "composition_digest": {"$ref":"#/$defs/sha256"},
    "prerequisites": {"type":"array", "items":{"type":"object","additionalProperties":false,"required":["id","depends_on"],"properties":{"id":{"type":"string","minLength":1},"depends_on":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}},
    "deadlines": {"type":"object", "minProperties":1, "additionalProperties":{"type":"string","pattern":"^[1-9][0-9]*(ms|s|m|h)$"}},
    "concurrency": {"type":"object", "additionalProperties":false, "required":["max_parallel"], "properties":{"max_parallel":{"type":"integer","minimum":1}}},
    "retry_policy": {"type":"object", "additionalProperties":false, "required":["max_attempts","stateful_replay"], "properties":{"max_attempts":{"type":"integer","minimum":1},"stateful_replay":{"type":"boolean"}}}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "relativePath":{"type":"string","minLength":1,"not":{"anyOf":[{"pattern":"^/"},{"pattern":"(^|/)\\.\\.(/|$)"},{"pattern":"(^|/)tmp(/|$)"}]}}
  }
}
