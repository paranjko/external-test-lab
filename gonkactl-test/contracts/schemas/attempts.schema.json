{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://gonka.dev/gonkactl-test/schemas/v1/attempts.schema.json",
  "title":"gonkactl-test attempts v1", "type":"object", "additionalProperties":false, "required":["schema_version","run_id","attempts"],
  "properties":{"schema_version":{"type":"string","pattern":"^1\\.[0-9]+\\.[0-9]+$"},"run_id":{"type":"string","minLength":1},"attempts":{"type":"array","items":{"$ref":"#/$defs/attempt"}}},
  "$defs":{"attempt":{"type":"object","additionalProperties":false,"required":["case_id","attempt_id","result_uuid","history_id","started_at","finished_at","status","failed_stage","failure_domain","assertion_evidence","interrupted","origin_event_ids"],"properties":{
    "case_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"result_uuid":{"type":"string","format":"uuid"},"history_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "started_at":{"type":"string","format":"date-time"},"finished_at":{"type":["string","null"],"format":"date-time"},"status":{"enum":["passed","failed","broken","skipped","unknown"]},"failed_stage":{"type":["string","null"]},
    "failure_domain":{"enum":["product","fixture","runner","infrastructure","unknown"]},"assertion_evidence":{"type":"array","items":{"type":"string","minLength":1}},"interrupted":{"type":"boolean"},"origin_event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }}}
}
