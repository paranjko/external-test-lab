[Unit]
Description=Repository-scoped GitHub Actions runner for external-test-lab
After=network-online.target
Wants=network-online.target

[Service]
User=github-actions-runner
Group=github-actions-runner
WorkingDirectory=/srv/actions-runner/external-test-lab
ExecStart=/srv/actions-runner/external-test-lab/run.sh
Restart=on-failure
RestartSec=5
KillMode=process
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/srv/actions-runner/external-test-lab
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
