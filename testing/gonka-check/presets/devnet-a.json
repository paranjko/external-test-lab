{
  "name": "devnet-a",
  "point": "gateway A",
  "base_url": "https://api.gonka-dev.net",
  "gateway_path": "/a",
  "model": "Qwen/Qwen3-0.6B",
  "health_url": null,
  "chain_rpc": "https://api.gonka-dev.net/chain-rpc",
  "chain_api": "https://api.gonka-dev.net/chain-api/productscience/inference/inference",
  "send_window": {"from_offset": 1, "stop_before_end": 20},
  "min_blocks_between_sends": 2,
  "deadline_s": 60,
  "socket_timeout_s": 70,
  "chain_poll_s": 3,
  "health_poll_s": 8,
  "health_max_age_s": 30,
  "budget": {"per_run": 4, "per_epoch": 4},
  "node_rpcs": [
    "https://node0.gonka-dev.net/chain-rpc",
    "https://node1.gonka-dev.net/chain-rpc",
    "https://node2.gonka-dev.net/chain-rpc",
    "https://node4.gonka-dev.net/chain-rpc",
    "https://node6.gonka-dev.net/chain-rpc",
    "https://node7.gonka-dev.net/chain-rpc"
  ],
  "node_max_lag_blocks": 5,
  "chain_advance_wait_s": 12,
  "watch_interval_s": 10,
  "profiles_allowed": ["smoke", "chain"],
  "forbid_paths": ["/status/gateway/", "/v1/admission-status"]
}
